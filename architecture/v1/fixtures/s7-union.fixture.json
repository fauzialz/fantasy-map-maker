{
  "stage": "S7",
  "description": "unionLand: a new brush region unions with OVERLAPPING existing land (one continuous coastline) but stays SEPARATE from detached land. Two cases.",
  "params": { "SCALE": 100, "tol": 0.01 },
  "cases": [
    {
      "case": "overlap-merges",
      "input": {
        "existing": [ { "type": "polygon", "path": [[100,100],[300,100],[300,300],[100,300]] } ],
        "new": [ { "type": "polygon", "path": [[250,150],[450,150],[450,350],[250,350]] } ]
      },
      "assertions": [
        { "type": "polygonCount", "n": 1, "note": "Overlapping rectangles union into one L/overlap polygon." }
      ]
    },
    {
      "case": "disjoint-stays-two",
      "input": {
        "existing": [ { "type": "polygon", "path": [[100,100],[250,100],[250,250],[100,250]] } ],
        "new": [ { "type": "polygon", "path": [[400,100],[550,100],[550,250],[400,250]] } ]
      },
      "assertions": [
        { "type": "polygonCount", "n": 2, "note": "Detached regions remain two separate landmasses." }
      ]
    }
  ]
}
